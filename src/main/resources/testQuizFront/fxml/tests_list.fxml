<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Controllers.testQuizFront.FrontTestsListController"
            stylesheets="@../css/tests_list.css"
            styleClass="tests-front-root">

    <padding>
        <Insets top="12" right="12" bottom="12" left="12"/>
    </padding>

    <top>
        <VBox spacing="10">
            <Label text="Tests Disponibles" styleClass="tests-front-title"/>
            <Label text="Choisissez un test et demarrez votre quiz." styleClass="tests-front-subtitle"/>
            <HBox spacing="10" styleClass="tests-front-toolbar">
                <padding>
                    <Insets top="10" right="10" bottom="10" left="10"/>
                </padding>
                <TextField fx:id="searchField" promptText="Rechercher par titre/type..." styleClass="tests-front-search"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Rafraichir" styleClass="btn-secondary-front" onAction="#handleRefresh"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox spacing="8">
            <BorderPane.margin>
                <Insets top="12"/>
            </BorderPane.margin>
            <Label fx:id="emptyLabel" text="Aucun test trouve." visible="false" managed="false" styleClass="tests-front-empty"/>
            <ScrollPane fitToWidth="true" fitToHeight="true" VBox.vgrow="ALWAYS" styleClass="tests-front-scroll">
                <content>
                    <FlowPane fx:id="cardsFlow" hgap="14" vgap="14" prefWrapLength="1080" styleClass="tests-front-flow"/>
                </content>
            </ScrollPane>
        </VBox>
    </center>

</BorderPane>
