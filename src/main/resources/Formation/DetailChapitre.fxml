<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.image.ImageView?>

<BorderPane prefHeight="650.0" prefWidth="980.0"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Controllers.Formation.DetailChapitre"
            stylesheets="@../Formation/app.css"
            styleClass="page">

    <top>
        <HBox spacing="10" alignment="CENTER_LEFT" styleClass="card">
            <BorderPane.margin>
                <Insets top="20.0" right="20.0" bottom="10.0" left="20.0" />
            </BorderPane.margin>

            <Button fx:id="btnRetour" mnemonicParsing="false" text="Retour" styleClass="btn-ghost" />

            <VBox spacing="2">
                <Label fx:id="lblTitre" text="Chapitre" styleClass="header-title" />
                <Label fx:id="lblMeta" text="" style="-fx-text-fill: #6b7280;" />
            </VBox>

            <Region HBox.hgrow="ALWAYS" />

            <Button fx:id="btnResume" mnemonicParsing="false" text="Résumé" styleClass="btn-secondary" />

            <Button fx:id="btnOuvrirPdf" mnemonicParsing="false" text="Ouvrir PDF" styleClass="btn-primary" />
        </HBox>
    </top>

    <center>
        <VBox spacing="14" styleClass="card">
            <BorderPane.margin>
                <Insets top="10.0" right="20.0" bottom="20.0" left="20.0" />
            </BorderPane.margin>

            <StackPane>
                <ScrollPane fx:id="spText" fitToWidth="true" prefHeight="520.0" styleClass="cards-scroll">
                    <content>
                        <TextArea fx:id="taContenu" editable="false" wrapText="true" prefHeight="520.0" styleClass="add-input" />
                    </content>
                </ScrollPane>

                <VBox fx:id="pdfPane" spacing="10" visible="false" managed="false">
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <ComboBox fx:id="cbPdfs" prefWidth="420" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button fx:id="btnPrevPage" text="◀" styleClass="btn-ghost" />
                        <Label fx:id="lblPage" text="" style="-fx-text-fill: #6b7280;" />
                        <Button fx:id="btnNextPage" text="▶" styleClass="btn-ghost" />
                    </HBox>

                    <ScrollPane fx:id="spPdf" fitToWidth="true" prefHeight="520.0" styleClass="cards-scroll">
                        <content>
                            <ImageView fx:id="ivPdf" preserveRatio="true" smooth="true" />
                        </content>
                    </ScrollPane>
                </VBox>
            </StackPane>

            <Label fx:id="lblMessage" text="" />
        </VBox>
    </center>

</BorderPane>
