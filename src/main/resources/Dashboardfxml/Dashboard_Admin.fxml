<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Controllers.Dashboard.Dashboard_Admin"
            stylesheets="@../Dashboardcss/back.css"
            styleClass="admin-root">

    <left>
        <VBox fx:id="sidebar"
              spacing="10"
              styleClass="admin-sidebar-rail"
              onMouseEntered="#expandSidebar"
              onMouseExited="#collapseSidebar">

            <padding>
                <Insets top="16" right="12" bottom="16" left="12"/>
            </padding>

            <StackPane styleClass="admin-rail-top">
                <Label text="" styleClass="admin-rail-dot"/>
            </StackPane>

            <Region minHeight="6" maxHeight="6"/>

            <!-- DASHBOARD -->
            <Button onAction="#openDashboard" styleClass="admin-rail-item">
                <graphic>
                    <HBox spacing="10" alignment="CENTER_LEFT" styleClass="admin-rail-item-graphic">
                        <Label text="🏠" styleClass="admin-rail-ico"/>
                        <Label fx:id="lblDash" text="Dashboard" styleClass="admin-rail-text" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    </HBox>
                </graphic>
            </Button>

            <!-- CANDIDATURES -->
            <Button onAction="#openCandidatures" styleClass="admin-rail-item admin-rail-active">
                <graphic>
                    <HBox spacing="10" alignment="CENTER_LEFT" styleClass="admin-rail-item-graphic">
                        <Label text="📁" styleClass="admin-rail-ico"/>
                        <Label fx:id="lblCand" text="Candidatures" styleClass="admin-rail-text" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    </HBox>
                </graphic>
            </Button>

            <!-- ENTRETIENS -->
            <Button onAction="#openEntretiens" styleClass="admin-rail-item">
                <graphic>
                    <HBox spacing="10" alignment="CENTER_LEFT" styleClass="admin-rail-item-graphic">
                        <Label text="🗓" styleClass="admin-rail-ico"/>
                        <Label fx:id="lblEnt" text="Entretiens" styleClass="admin-rail-text" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    </HBox>
                </graphic>
            </Button>

            <!-- TESTS -->
            <Button onAction="#openTests" styleClass="admin-rail-item">
                <graphic>
                    <HBox spacing="10" alignment="CENTER_LEFT" styleClass="admin-rail-item-graphic">
                        <Label text="🧪" styleClass="admin-rail-ico"/>
                        <Label fx:id="lblTests" text="Tests" styleClass="admin-rail-text" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    </HBox>
                </graphic>
            </Button>

            <!-- PUBLICATIONS -->
            <Button onAction="#openPublications" styleClass="admin-rail-item">
                <graphic>
                    <HBox spacing="10" alignment="CENTER_LEFT" styleClass="admin-rail-item-graphic">
                        <Label text="📝" styleClass="admin-rail-ico"/>
                        <Label fx:id="lblPubs" text="Publications" styleClass="admin-rail-text" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    </HBox>
                </graphic>
            </Button>

            <!-- FORMATIONS -->
            <Button onAction="#openFormations" styleClass="admin-rail-item">
                <graphic>
                    <HBox spacing="10" alignment="CENTER_LEFT" styleClass="admin-rail-item-graphic">
                        <Label text="🎓" styleClass="admin-rail-ico"/>
                        <Label fx:id="lblForms" text="Formations" styleClass="admin-rail-text" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    </HBox>
                </graphic>
            </Button>

            <!-- OFFRES -->
            <Button onAction="#openOffres" styleClass="admin-rail-item">
                <graphic>
                    <HBox spacing="10" alignment="CENTER_LEFT" styleClass="admin-rail-item-graphic">
                        <Label text="💼" styleClass="admin-rail-ico"/>
                        <Label fx:id="lblOffres" text="Offres" styleClass="admin-rail-text" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    </HBox>
                </graphic>
            </Button>

            <!-- ENTREPRISE -->
            <Button onAction="#openEntreprise" styleClass="admin-rail-item">
                <graphic>
                    <HBox spacing="10" alignment="CENTER_LEFT" styleClass="admin-rail-item-graphic">
                        <Label text="🏢" styleClass="admin-rail-ico"/>
                        <Label fx:id="lblEntreprise" text="Entreprise" styleClass="admin-rail-text" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    </HBox>
                </graphic>
            </Button>

            <Region VBox.vgrow="ALWAYS"/>

            <!-- LOGOUT -->
            <Button onAction="#logout" styleClass="admin-rail-item admin-rail-logout">
                <graphic>
                    <HBox spacing="10" alignment="CENTER_LEFT" styleClass="admin-rail-item-graphic">
                        <Label text="⏻" styleClass="admin-rail-ico admin-rail-ico-danger"/>
                        <Label fx:id="lblLogout" text="Log out" styleClass="admin-rail-text" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    </HBox>
                </graphic>
            </Button>
        </VBox>
    </left>

    <top>
        <HBox spacing="14" alignment="CENTER_LEFT" styleClass="admin-topbar">
            <padding>
                <Insets top="12" right="16" bottom="12" left="16"/>
            </padding>

            <HBox spacing="12" alignment="CENTER_LEFT">
                <StackPane styleClass="admin-topbar-logoWrap">
                    <ImageView fitWidth="34" fitHeight="34" preserveRatio="true">
                        <image>
                            <Image url="/User/Assets/avatar.png"/>
                        </image>
                    </ImageView>
                </StackPane>

                <VBox spacing="2">
                    <Label text="Hello, ManagerRH" styleClass="admin-hello"/>
                    <Label text="Gérez les candidatures et les entretiens" styleClass="admin-subhello"/>
                </VBox>
            </HBox>

            <Region HBox.hgrow="ALWAYS"/>

            <HBox spacing="10" alignment="CENTER_RIGHT">
                <HBox spacing="10" alignment="CENTER_LEFT" styleClass="admin-searchWrap">
                    <Label text="🔎" styleClass="admin-searchIco"/>
                    <TextField promptText="Search..." styleClass="admin-searchField"/>
                </HBox>

                <Button text="⟶" styleClass="admin-searchBtn"/>
            </HBox>
        </HBox>
    </top>

    <center>
        <StackPane fx:id="adminCenter" styleClass="admin-center">
            <padding>
                <Insets top="18" right="18" bottom="18" left="18"/>
            </padding>

            <StackPane fx:id="adminContentArea" id="adminContentArea" styleClass="admin-content"/>
            <!-- COPILOTE VOCAL -->
            <fx:include fx:id="copiloteVocal"
                        source="/candidaturefxml/CopiloteVocal.fxml"
                        StackPane.alignment="BOTTOM_RIGHT"
                        pickOnBounds="false"/>
        </StackPane>
    </center>

</BorderPane>
