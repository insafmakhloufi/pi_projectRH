<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="Controllers.User.VerifyEmailController">

    <BorderPane styleClass="auth-root" AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
                AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">

        <center>
            <StackPane styleClass="auth-bg">
                <Region styleClass="auth-bg-overlay" />
                <StackPane styleClass="auth-form-wrap">
                    <ScrollPane fx:id="scrollPane" fitToWidth="true" pannable="false" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" styleClass="auth-form-scroll">
                        <VBox fx:id="contentBox" alignment="CENTER" fillWidth="true" styleClass="auth-form-content">
                            <VBox styleClass="auth-card" spacing="14" maxWidth="460" fillWidth="true">

                                <VBox spacing="6">
                                    <Label text="Verify Email" styleClass="auth-title" />
                                    <Label fx:id="hintLabel" text="Enter the code we sent to your email" styleClass="auth-subtitle" wrapText="true" />
                                </VBox>

                                <VBox spacing="6" fillWidth="true">
                                    <Label text="Code" styleClass="field-label" />
                                    <HBox spacing="10" alignment="CENTER">
                                        <TextField fx:id="c1" prefWidth="40" prefHeight="44" maxWidth="40" styleClass="otp-digit" />
                                        <TextField fx:id="c2" prefWidth="40" prefHeight="44" maxWidth="40" styleClass="otp-digit" />
                                        <TextField fx:id="c3" prefWidth="40" prefHeight="44" maxWidth="40" styleClass="otp-digit" />
                                        <TextField fx:id="c4" prefWidth="40" prefHeight="44" maxWidth="40" styleClass="otp-digit" />
                                        <TextField fx:id="c5" prefWidth="40" prefHeight="44" maxWidth="40" styleClass="otp-digit" />
                                        <TextField fx:id="c6" prefWidth="40" prefHeight="44" maxWidth="40" styleClass="otp-digit" />
                                    </HBox>
                                    <Label fx:id="codeError" styleClass="error-label" />
                                </VBox>

                                <Label fx:id="statusLabel" styleClass="success-label" />

                                <Button text="Verify" onAction="#handleVerify" styleClass="btn-primary" maxWidth="Infinity" />

                                <HBox alignment="CENTER" spacing="6">
                                    <Label text="Didn't get a code?" styleClass="muted" />
                                    <Hyperlink text="Resend" onAction="#handleResend" styleClass="link" />
                                </HBox>

                                <HBox alignment="CENTER" spacing="6">
                                    <Label text="Back" styleClass="muted" />
                                    <Hyperlink text="Login" onAction="#goToLogin" styleClass="link" />
                                </HBox>

                            </VBox>
                        </VBox>
                    </ScrollPane>
                </StackPane>
            </StackPane>
        </center>

    </BorderPane>
</AnchorPane>
