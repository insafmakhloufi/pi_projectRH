<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="Controllers.User.ForgotPasswordController">

    <BorderPane styleClass="auth-root" AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
                AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">

        <left>
            <StackPane styleClass="auth-hero" prefWidth="560" minWidth="420">
                <Region styleClass="auth-hero-overlay" />
                <VBox styleClass="auth-hero-inner" spacing="18" maxWidth="460">
                    <VBox spacing="8">
                        <Label text="CareerLink" styleClass="auth-hero-brand" />
                        <Label text="Reset your password" styleClass="auth-hero-title" wrapText="true" />
                        <Label text="We’ll send you a one-time verification code to confirm your identity." styleClass="auth-hero-text" wrapText="true" />
                    </VBox>

                    <VBox spacing="12" styleClass="auth-hero-list">
                        <HBox spacing="10" alignment="CENTER_LEFT" styleClass="auth-hero-item">
                            <Label text="✓" styleClass="auth-hero-check" />
                            <Label text="Email or WhatsApp verification" styleClass="auth-hero-item-text" />
                        </HBox>
                        <HBox spacing="10" alignment="CENTER_LEFT" styleClass="auth-hero-item">
                            <Label text="✓" styleClass="auth-hero-check" />
                            <Label text="Fast, secure recovery" styleClass="auth-hero-item-text" />
                        </HBox>
                        <HBox spacing="10" alignment="CENTER_LEFT" styleClass="auth-hero-item">
                            <Label text="✓" styleClass="auth-hero-check" />
                            <Label text="No password reuse" styleClass="auth-hero-item-text" />
                        </HBox>
                    </VBox>

                    <VBox spacing="8" styleClass="auth-hero-slogan-wrap">
                        <Label text="Back to work in minutes." styleClass="auth-hero-slogan" wrapText="true" />
                        <Label text="Enter your email or phone and we’ll help you regain access." styleClass="auth-hero-caption" wrapText="true" />
                    </VBox>
                </VBox>
            </StackPane>
        </left>

        <center>
            <StackPane styleClass="auth-form-wrap">
                <ScrollPane fx:id="scrollPane" fitToWidth="true" pannable="false" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" styleClass="auth-form-scroll">
                    <VBox fx:id="contentBox" alignment="CENTER" fillWidth="true" styleClass="auth-form-content">
                        <VBox styleClass="auth-card" spacing="14" maxWidth="460" fillWidth="true">

                            <VBox spacing="6">
                                <Label text="Forgot Password" styleClass="auth-title" />
                                <Label text="Choose where to receive your verification code" styleClass="auth-subtitle" wrapText="true" />
                            </VBox>

                            <VBox spacing="6" fillWidth="true">
                                <Label text="Email" styleClass="field-label" />
                                <TextField fx:id="emailField" promptText="you@company.com" maxWidth="Infinity" />
                                <Label fx:id="emailError" styleClass="error-label" />
                            </VBox>

                            <VBox spacing="6" fillWidth="true">
                                <Label text="Phone" styleClass="field-label" />
                                <HBox alignment="CENTER_LEFT" spacing="10">
                                    <ComboBox fx:id="phoneCountryCodeCombo" prefWidth="180" promptText="Tunisia (+216)" />
                                    <TextField fx:id="phoneField" promptText="29xxxxxx" maxWidth="Infinity" HBox.hgrow="ALWAYS" />
                                </HBox>
                                <Label fx:id="phoneError" styleClass="error-label" />
                            </VBox>

                            <VBox spacing="6" fillWidth="true">
                                <Label text="Channel" styleClass="field-label" />
                                <ComboBox fx:id="channelCombo" maxWidth="Infinity" promptText="Select channel" />
                                <Label fx:id="channelError" styleClass="error-label" />
                            </VBox>

                            <Label fx:id="statusLabel" styleClass="success-label" />

                            <Button text="Send code" onAction="#handleSendCode" styleClass="btn-primary" maxWidth="Infinity" />

                            <HBox alignment="CENTER" spacing="6">
                                <Label text="Back to login" styleClass="muted" />
                                <Hyperlink text="Login" onAction="#goToLogin" styleClass="link" />
                            </HBox>

                        </VBox>
                    </VBox>
                </ScrollPane>
            </StackPane>
        </center>

    </BorderPane>
</AnchorPane>
