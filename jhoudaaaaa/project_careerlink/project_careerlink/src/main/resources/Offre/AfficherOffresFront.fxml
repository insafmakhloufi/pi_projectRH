<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.chart.AreaChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Controllers.Offre.AfficherOffresFront"
            stylesheets="@../cssOffre/wizard.css"
            fitToWidth="true"
            pannable="true"
            hbarPolicy="NEVER"
            vbarPolicy="AS_NEEDED"
            styleClass="dash-scroll">

    <content>
        <VBox styleClass="offer-front-wrap">

    <HBox styleClass="wizard-card offer-front-header" alignment="CENTER_LEFT" spacing="12">
        <VBox spacing="4">
            <Label text="Offres d'emploi disponibles" styleClass="hero-title"/>
            <Label text="Choisis une offre et postule en un clic" styleClass="hero-subtitle"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        
        <!-- Boutons organisés sur 2 lignes -->
        <VBox spacing="8" alignment="CENTER_RIGHT">
            <HBox spacing="8" alignment="CENTER_RIGHT">
                <ComboBox fx:id="secteurFilter" promptText="🎯 Secteur" styleClass="front-filter-combo" />
                <Button fx:id="btnRecommandees" text="💡 Recommandées" styleClass="btn-primary" onAction="#afficherOffresRecommandees"/>
                <Button fx:id="btnNouveau" text="🏷️ Nouveau" styleClass="btn-secondary" onAction="#afficherOffresRecentes"/>
            </HBox>
            <HBox spacing="8" alignment="CENTER_RIGHT">
                <ComboBox fx:id="dateFilter" promptText="📅 Date" styleClass="front-filter-combo" />
                <Button fx:id="btnFavoris" text="♥ Mes Favoris" styleClass="btn-secondary" onAction="#afficherMesFavoris"/>
                <Button fx:id="btnComparer" text="⚖️ Comparer" styleClass="btn-secondary" onAction="#comparerSelection"/>
                <Button fx:id="mapBtn" text="🗺️ Carte" styleClass="btn-secondary" onAction="#ouvrirCarteOffres"/>
                <Button fx:id="refreshBtn" text="🔄" styleClass="btn-secondary" onAction="#refresh"/>
            </HBox>
        </VBox>
    </HBox>

    <HBox spacing="14" alignment="TOP_LEFT">
        <VBox spacing="10" minWidth="0" HBox.hgrow="ALWAYS">
            <ScrollPane fitToHeight="true" fitToWidth="false" pannable="true" hbarPolicy="AS_NEEDED" vbarPolicy="NEVER" styleClass="pos-selector-scroll" minHeight="64" prefHeight="64">
                <content>
                    <HBox fx:id="positionChipsBox" spacing="10" styleClass="pos-selector" minHeight="56" />
                </content>
            </ScrollPane>

            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" prefHeight="600" styleClass="dash-scroll" style="-fx-background-color: transparent;">
                <content>
                    <StackPane alignment="CENTER" style="-fx-background-color: transparent;">
                        <FlowPane fx:id="offersFlowPane"
                                  styleClass="offer-front-grid"
                                  maxWidth="Infinity"
                                  cache="true"
                                  cacheHint="speed"
                                  alignment="CENTER"/>
                    </StackPane>
                </content>
            </ScrollPane>
        </VBox>

        <VBox prefWidth="380" minWidth="380" maxWidth="380" spacing="16" styleClass="front-side-panel">
            <!-- Stats Panel (shown by default) -->
            <VBox fx:id="statsPanel" spacing="16" VBox.vgrow="ALWAYS">
                <Label text="Statistiques des secteurs" styleClass="front-side-title" />
                <VBox spacing="8" styleClass="wizard-card">
                    <padding>
                        <Insets top="12" right="12" bottom="12" left="12"/>
                    </padding>
                    <AreaChart fx:id="secteurAreaChart" animated="false" legendVisible="false" createSymbols="false" horizontalGridLinesVisible="false" verticalGridLinesVisible="false" alternativeColumnFillVisible="false" alternativeRowFillVisible="false" styleClass="front-area-chart">
                        <xAxis>
                            <CategoryAxis fx:id="secteurChartXAxis" tickLabelRotation="-20" />
                        </xAxis>
                        <yAxis>
                            <NumberAxis fx:id="secteurChartYAxis" autoRanging="true" forceZeroInRange="true" />
                        </yAxis>
                    </AreaChart>
                </VBox>

                <Label text="Carte des localisations" styleClass="front-side-title" />
                <VBox spacing="8" styleClass="wizard-card" VBox.vgrow="ALWAYS">
                    <padding>
                        <Insets top="12" right="12" bottom="12" left="12"/>
                    </padding>
                    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" styleClass="loc-list-scroll" VBox.vgrow="ALWAYS">
                        <content>
                            <VBox fx:id="locationListBox" spacing="10" minHeight="180" prefHeight="180" styleClass="loc-list" />
                        </content>
                    </ScrollPane>
                </VBox>
            </VBox>

            <!-- Details Panel (shown when clicking Details) -->
            <VBox fx:id="detailsPanel" spacing="16" visible="false" managed="false" VBox.vgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Label text="📋 Détails de l'offre" styleClass="front-side-title" />
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="✕" onAction="#closeDetailsPanel" styleClass="btn-secondary" style="-fx-padding: 4 10; -fx-font-size: 14px;"/>
                </HBox>

                <VBox fx:id="offerDetailsContent" spacing="16" styleClass="wizard-card" VBox.vgrow="ALWAYS">
                    <padding>
                        <Insets top="16" right="16" bottom="16" left="16"/>
                    </padding>
                    <!-- Content will be added dynamically -->
                </VBox>
            </VBox>
        </VBox>
    </HBox>

        </VBox>
    </content>
</ScrollPane>
