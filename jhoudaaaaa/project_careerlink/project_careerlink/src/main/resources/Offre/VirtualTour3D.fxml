<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<StackPane fx:id="rootContainer" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.Offre.VirtualTour3DController">
    
    <!-- Écran d'accueil / Tutoriel -->
    <VBox fx:id="welcomeScreen" alignment="CENTER" spacing="25" 
          style="-fx-background-color: linear-gradient(135deg, #1e293b 0%, #334155 50%, #475569 100%);" 
          StackPane.alignment="CENTER">
        
        <padding>
            <Insets top="50" right="60" bottom="50" left="60"/>
        </padding>
        
        <Label text="🌐" style="-fx-font-size: 80px;"/>
        <Label text="Virtual Tour 3D" style="-fx-font-size: 42px; -fx-font-weight: 800; -fx-text-fill: #60a5fa;"/>
        <Label text="Explorez les entreprises et leurs offres d'emploi en 3D" style="-fx-font-size: 18px; -fx-text-fill: #94a3b8;"/>
        
        <VBox spacing="20" style="-fx-background-color: rgba(30, 41, 59, 0.9); -fx-padding: 40; -fx-background-radius: 20; -fx-border-color: #f97316; -fx-border-width: 3; -fx-border-radius: 20;">
            <effect>
                <DropShadow color="#f97316" radius="25" spread="0.2"/>
            </effect>
            
            <Label text="📖 Comment ça marche ?" style="-fx-font-size: 24px; -fx-font-weight: 700; -fx-text-fill: white;"/>
            
            <HBox spacing="30" alignment="CENTER">
                <VBox spacing="15" alignment="CENTER" style="-fx-background-color: rgba(249, 115, 22, 0.3); -fx-padding: 25; -fx-background-radius: 15; -fx-border-color: #f97316; -fx-border-width: 2; -fx-border-radius: 15;">
                    <Label text="🏢" style="-fx-font-size: 50px;"/>
                    <Label text="BÂTIMENTS ORANGE" style="-fx-font-size: 14px; -fx-font-weight: 700; -fx-text-fill: #fb923c;"/>
                    <Label text="= Entreprises" wrapText="true" style="-fx-font-size: 13px; -fx-text-fill: #ffedd5;"/>
                    <Label text="Plus c'est haut = plus d'offres" wrapText="true" style="-fx-font-size: 11px; -fx-text-fill: #fed7aa;"/>
                </VBox>
                
                <VBox spacing="15" alignment="CENTER" style="-fx-background-color: rgba(34, 197, 94, 0.3); -fx-padding: 25; -fx-background-radius: 15; -fx-border-color: #22c55e; -fx-border-width: 2; -fx-border-radius: 15;">
                    <Label text="🟢" style="-fx-font-size: 50px;"/>
                    <Label text="SPHÈRES VERTES" style="-fx-font-size: 14px; -fx-font-weight: 700; -fx-text-fill: #4ade80;"/>
                    <Label text="= Offres d'emploi" wrapText="true" style="-fx-font-size: 13px; -fx-text-fill: #dcfce7;"/>
                    <Label text="Flottent autour des bâtiments" wrapText="true" style="-fx-font-size: 11px; -fx-text-fill: #bbf7d0;"/>
                </VBox>
            </HBox>
        </VBox>
        
        <Button fx:id="btnStartTour" text="🚀 Commencer le Virtual Tour" 
                style="-fx-background-color: linear-gradient(135deg, #f97316 0%, #ea580c 100%); -fx-text-fill: white; -fx-font-weight: 800; -fx-font-size: 20px; -fx-padding: 25 60; -fx-background-radius: 35; -fx-cursor: hand; -fx-border-color: #fff7ed; -fx-border-width: 3; -fx-border-radius: 35;">
            <effect>
                <DropShadow color="#f97316" radius="20" spread="0.4"/>
            </effect>
        </Button>
    </VBox>
    
    <!-- UI du tour (invisible au début) -->
    <VBox fx:id="tourUI" alignment="TOP_CENTER" spacing="10" visible="false" managed="false" pickOnBounds="false" StackPane.alignment="TOP_CENTER">
        <padding>
            <Insets top="12" right="12" bottom="12" left="12"/>
        </padding>
        
        <HBox alignment="CENTER" spacing="10" maxWidth="520" style="-fx-background-color: rgba(15, 23, 42, 0.75); -fx-padding: 10 18; -fx-background-radius: 14; -fx-border-color: rgba(249, 115, 22, 0.9); -fx-border-width: 2; -fx-border-radius: 14;">
            <Label text="🌐 Virtual Tour 3D" style="-fx-font-size: 22px; -fx-font-weight: 800; -fx-text-fill: #fb923c;"/>
        </HBox>
    </VBox>
    
    <VBox fx:id="controlsPanel" alignment="TOP_LEFT" spacing="12" visible="false" managed="false" pickOnBounds="false" StackPane.alignment="TOP_LEFT">
        <padding>
            <Insets top="80" left="16"/>
        </padding>
        <VBox spacing="10" maxWidth="240" style="-fx-background-color: rgba(15, 23, 42, 0.75); -fx-padding: 14; -fx-background-radius: 14; -fx-border-color: rgba(148, 163, 184, 0.45); -fx-border-width: 1; -fx-border-radius: 14;">
            <Button fx:id="btnResetView" text="🔄 Vue initiale" style="-fx-background-color: #f97316; -fx-text-fill: white; -fx-font-weight: 700; -fx-padding: 14 24; -fx-background-radius: 8; -fx-cursor: hand; -fx-font-size: 13px;"/>
            <Button fx:id="btnToggleLabels" text="🏷️ Voir/Masquer" style="-fx-background-color: #475569; -fx-text-fill: white; -fx-font-weight: 600; -fx-padding: 14 24; -fx-background-radius: 8; -fx-cursor: hand; -fx-font-size: 13px;"/>
            <Button fx:id="btnHelp" text="❓ Aide" style="-fx-background-color: #22c55e; -fx-text-fill: white; -fx-font-weight: 600; -fx-padding: 14 24; -fx-background-radius: 8; -fx-cursor: hand; -fx-font-size: 13px;"/>
        </VBox>
    </VBox>
    
    <VBox fx:id="closePanel" alignment="TOP_RIGHT" visible="false" managed="false" pickOnBounds="false" StackPane.alignment="TOP_RIGHT">
        <padding>
            <Insets top="12" right="12"/>
        </padding>
        <Button fx:id="btnClose" text="✕ Fermer" style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-font-weight: 700; -fx-padding: 12 24; -fx-background-radius: 10; -fx-cursor: hand;"/>
    </VBox>
    
    <VBox fx:id="legendPanel" alignment="BOTTOM_LEFT" spacing="12" visible="false" managed="false" pickOnBounds="false" StackPane.alignment="BOTTOM_LEFT">
        <padding>
            <Insets bottom="12" left="12"/>
        </padding>
        <VBox spacing="10" maxWidth="360" style="-fx-background-color: rgba(15, 23, 42, 0.75); -fx-padding: 14; -fx-background-radius: 14; -fx-border-color: rgba(148, 163, 184, 0.45); -fx-border-width: 1; -fx-border-radius: 14;">
            <Label text="📍 Légende" style="-fx-font-size: 14px; -fx-font-weight: 700; -fx-text-fill: #fb923c;"/>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Region style="-fx-background-color: #f97316; -fx-min-width: 25; -fx-min-height: 25; -fx-background-radius: 3;"/>
                <Label text="= Entreprise (plus haut = plus d'offres)" style="-fx-font-size: 13px; -fx-text-fill: white; -fx-font-weight: 600;"/>
            </HBox>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Region style="-fx-background-color: #22c55e; -fx-min-width: 20; -fx-min-height: 20; -fx-background-radius: 50;"/>
                <Label text="= Offre d'emploi disponible" style="-fx-font-size: 13px; -fx-text-fill: white; -fx-font-weight: 600;"/>
            </HBox>
        </VBox>
    </VBox>
    
</StackPane>
