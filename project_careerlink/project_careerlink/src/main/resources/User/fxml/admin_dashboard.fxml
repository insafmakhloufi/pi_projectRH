<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<BorderPane styleClass="app-root" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.User.AdminDashboardController">

    <left>
        <VBox prefWidth="260" spacing="10" styleClass="sidebar">
            <VBox spacing="4" styleClass="sidebar-header">
                <Label styleClass="sidebar-brand" text="CareerLink" />
                <Label styleClass="sidebar-sub" text="Admin Dashboard" />
            </VBox>
            <Separator />

            <Button fx:id="dashboardNav" maxWidth="Infinity" onAction="#showDashboard" styleClass="nav-item" text="Dashboard">
                <graphic>
                    <SVGPath content="M4 4h7v7H4V4Zm9 0h7v4h-7V4ZM13 10h7v10h-7V10ZM4 13h7v7H4v-7Z" />
                </graphic>
            </Button>
            <Button fx:id="usersNav" maxWidth="Infinity" onAction="#showUsers" styleClass="nav-item" text="Users">
                <graphic>
                    <SVGPath content="M16 11c1.66 0 3-1.34 3-3S17.66 5 16 5s-3 1.34-3 3s1.34 3 3 3ZM8 11c1.66 0 3-1.34 3-3S9.66 5 8 5S5 6.34 5 8s1.34 3 3 3Zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5C15 14.17 10.33 13 8 13Zm8 0c-.29 0-.62.02-.97.05c1.16.84 1.97 1.99 1.97 3.45V19h6v-2.5C23 14.17 18.33 13 16 13Z" />
                </graphic>
            </Button>
            <Button fx:id="settingsNav" maxWidth="Infinity" onAction="#showSettings" styleClass="nav-item" text="Settings">
                <graphic>
                    <SVGPath content="M19.14 12.94c.04-.31.06-.63.06-.94s-.02-.63-.06-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.11-.2-.36-.28-.57-.2l-2.39.96c-.5-.38-1.03-.69-1.62-.94L14.5 2.5c-.04-.22-.23-.38-.45-.38h-3.1c-.22 0-.41.16-.45.38l-.38 2.47c-.59.25-1.13.56-1.62.94l-2.39-.96c-.21-.08-.46 0-.57.2L3.62 8.47c-.11.2-.06.47.12.61l2.03 1.58c-.04.31-.06.63-.06.94s.02.63.06.94L3.74 14.52c-.18.14-.23.41-.12.61l1.92 3.32c.11.2.36.28.57.2l2.39-.96c.5.38 1.03.69 1.62.94l.38 2.47c.04.22.23.38.45.38h3.1c.22 0 .41-.16.45-.38l.38-2.47c.59-.25 1.13-.56 1.62-.94l2.39.96c.21.08.46 0 .57-.2l1.92-3.32c.11-.2.06-.47-.12-.61l-2.03-1.58ZM12 15.5A3.5 3.5 0 1 1 12 8a3.5 3.5 0 0 1 0 7.5Z" />
                </graphic>
            </Button>

            <Region VBox.vgrow="ALWAYS" />

            <HBox alignment="CENTER_LEFT" maxWidth="Infinity" spacing="10" styleClass="sidebar-footer">
                <ImageView fitHeight="200.0" fitWidth="150.0" preserveRatio="true" styleClass="sidebar-footer-avatar">
                    <image>
                        <Image url="@../Assets/avatar.png" />
                    </image>
                </ImageView>
                <VBox alignment="CENTER_LEFT" spacing="2" HBox.hgrow="ALWAYS">
                    <Label styleClass="sidebar-footer-title" text="Welcome " />
                    <Label styleClass="sidebar-footer-title" text="Back " />
                    <Label styleClass="sidebar-footer-title" text="Admin ! " />
                </VBox>
            </HBox>

            <Button maxWidth="Infinity" onAction="#logout" styleClass="nav-item" text="Logout">
                <graphic>
                    <SVGPath content="M10 17l1.41-1.41L7.83 12H20v-2H7.83l3.58-3.59L10 5l-7 7l7 7Zm12 4H12v-2h10V5H12V3h10c1.1 0 2 .9 2 2v14c0 1.1-.9 2-2 2Z" />
                </graphic>
            </Button>
        </VBox>
    </left>

    <center>
        <VBox spacing="14" styleClass="content">

            <HBox alignment="CENTER_LEFT" spacing="12" styleClass="page-header">
                <VBox spacing="4">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label fx:id="pageTitle" styleClass="topbar-title" text="Dashboard" />
                        <HBox alignment="CENTER_LEFT" spacing="6" styleClass="date-pill">
                            <SVGPath content="M19 3h-1V1h-2v2H8V1H6v2H5c-1.11 0-1.99.9-1.99 2L3 19c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2Zm0 16H5V8h14v11ZM7 10h5v5H7z" styleClass="date-pill-icon" />
                            <Label fx:id="todayDateLabel" styleClass="date-pill-text" text="" />
                        </HBox>
                    </HBox>
                    <Label styleClass="topbar-subtitle" text="Welcome back! Here's what's happening today." />
                </VBox>

                <Region HBox.hgrow="ALWAYS" />

                <StackPane styleClass="topbar-search-wrap">
                    <TextField fx:id="searchField" promptText="Search users, profiles, documents..." styleClass="topbar-search" />
                </StackPane>

                <ToggleButton fx:id="themeToggleTop" focusTraversable="false" onAction="#toggleThemeFromTop" styleClass="theme-toggle" text="" />
                <Button focusTraversable="false" styleClass="topbar-icon" text="">
                    <graphic>
                        <SVGPath content="M12 22c1.1 0 2-.9 2-2h-4c0 1.1.9 2 2 2Zm6-6v-5c0-3.07-1.63-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5S10.5 3.17 10.5 4v.68C7.63 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2Z" />
                    </graphic>
                </Button>
                <MenuButton fx:id="userMenu" styleClass="topbar-avatar" text="Admin">
                    <graphic>
                        <StackPane>
                            <Circle fx:id="topbarAvatarCircle" radius="14" styleClass="topbar-avatar-circle" />
                            <ImageView fx:id="topbarAvatarImage" fitHeight="28" fitWidth="28" pickOnBounds="true" preserveRatio="false" />
                        </StackPane>
                    </graphic>
                    <items>
                        <MenuItem onAction="#showProfile" text="Profile" />
                        <MenuItem onAction="#showSettings" text="Settings" />
                    </items>
                </MenuButton>
            </HBox>

            <StackPane VBox.vgrow="ALWAYS">

            <VBox fx:id="dashboardPage" spacing="14" styleClass="page-container">
                <HBox spacing="14" styleClass="kpi-row">
                    <VBox spacing="8" styleClass="kpi-card" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <VBox spacing="2" HBox.hgrow="ALWAYS">
                                <Label styleClass="kpi-title" text="Total Users" />
                                <Label fx:id="totalUsersLabel" styleClass="kpi-value" text="0" />
                            </VBox>
                            <StackPane styleClass="kpi-icon">
                                <styleClass>
                                    <String fx:value="kpi-icon-blue" />
                                </styleClass>
                                <SVGPath content="M16 11c1.66 0 3-1.34 3-3S17.66 5 16 5s-3 1.34-3 3s1.34 3 3 3ZM8 11c1.66 0 3-1.34 3-3S9.66 5 8 5S5 6.34 5 8s1.34 3 3 3Zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5C15 14.17 10.33 13 8 13Zm8 0c-.29 0-.62.02-.97.05c1.16.84 1.97 1.99 1.97 3.45V19h6v-2.5C23 14.17 18.33 13 16 13Z" />
                            </StackPane>
                        </HBox>
                        <Label styleClass="kpi-sub" text="+12% from last month" />
                    </VBox>

                    <VBox spacing="8" styleClass="kpi-card" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <VBox spacing="2" HBox.hgrow="ALWAYS">
                                <Label styleClass="kpi-title" text="Admins" />
                                <Label fx:id="adminsLabel" styleClass="kpi-value" text="0" />
                            </VBox>
                            <StackPane styleClass="kpi-icon">
                                <styleClass>
                                    <String fx:value="kpi-icon-purple" />
                                </styleClass>
                                <SVGPath content="M12 2L4 5v6c0 5.55 3.84 10.74 8 12c4.16-1.26 8-6.45 8-12V5l-8-3Zm0 10.99h6c-.53 3.39-2.72 6.53-6 7.68V13H6V6.3l6-2.25v8.94Z" />
                            </StackPane>
                        </HBox>
                        <Label styleClass="kpi-sub" text="+5% from last month" />
                    </VBox>

                    <VBox spacing="8" styleClass="kpi-card" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <VBox spacing="2" HBox.hgrow="ALWAYS">
                                <Label styleClass="kpi-title" text="Candidates" />
                                <Label fx:id="candidatesLabel" styleClass="kpi-value" text="0" />
                            </VBox>
                            <StackPane styleClass="kpi-icon">
                                <styleClass>
                                    <String fx:value="kpi-icon-teal" />
                                </styleClass>
                                <SVGPath content="M12 12c2.21 0 4-1.79 4-4S14.21 4 12 4S8 5.79 8 8s1.79 4 4 4Zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4Z" />
                            </StackPane>
                        </HBox>
                        <Label styleClass="kpi-sub" text="+18% from last month" />
                    </VBox>
                </HBox>

                <HBox spacing="14" VBox.vgrow="ALWAYS">
                    <VBox prefWidth="320" spacing="10" styleClass="card">
                        <Label styleClass="section-title" text="Quick Actions" />
                        <Button maxWidth="Infinity" onAction="#showUsers" styleClass="quick-action" text="Manage Users">
                            <styleClass>
                                <String fx:value="qa-blue" />
                            </styleClass>
                            <graphic>
                                <SVGPath content="M16 11c1.66 0 3-1.34 3-3S17.66 5 16 5s-3 1.34-3 3s1.34 3 3 3ZM8 11c1.66 0 3-1.34 3-3S9.66 5 8 5S5 6.34 5 8s1.34 3 3 3Zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5C15 14.17 10.33 13 8 13Zm8 0c-.29 0-.62.02-.97.05c1.16.84 1.97 1.99 1.97 3.45V19h6v-2.5C23 14.17 18.33 13 16 13Z" styleClass="svg-path" />
                            </graphic>
                        </Button>
                        <Button maxWidth="Infinity" onAction="#createUser" styleClass="quick-action" text="Add New User">
                            <styleClass>
                                <String fx:value="qa-purple" />
                            </styleClass>
                            <graphic>
                                <SVGPath content="M12 12c2.21 0 4-1.79 4-4S14.21 4 12 4S8 5.79 8 8s1.79 4 4 4Zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4Zm9-7h-2V5h-2v2h-2v2h2v2h2V9h2V7Z" styleClass="svg-path" />
                            </graphic>
                        </Button>
                        <Button maxWidth="Infinity" onAction="#refreshUsers" styleClass="quick-action" text="Refresh Data">
                            <styleClass>
                                <String fx:value="qa-teal" />
                            </styleClass>
                            <graphic>
                                <SVGPath content="M12 4V1L8 5l4 4V6c3.31 0 6 2.69 6 6c0 .93-.21 1.81-.59 2.59l1.46 1.46C19.59 14.92 20 13.5 20 12c0-4.42-3.58-8-8-8Zm-6.82.41L3.72 5.86C2.96 7.07 2.5 8.5 2.5 10c0 4.42 3.58 8 8 8v3l4-4l-4-4v3c-3.31 0-6-2.69-6-6c0-.93.21-1.81.59-2.59Z" styleClass="svg-path" />
                            </graphic>
                        </Button>
                    </VBox>

                    <VBox spacing="10" styleClass="card" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label styleClass="section-title" text="Recent Activity" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label styleClass="pill" text="Today" />
                        </HBox>
                        <Label styleClass="muted" text="• New users will appear here after you create them." />
                        <Label styleClass="muted" text="• Use the Users page to edit or delete accounts." />
                        <Label styleClass="muted" text="• Search in the top bar to quickly filter the users table." />
                    </VBox>
                </HBox>
            </VBox>

            <VBox fx:id="usersPage" managed="false" spacing="12" styleClass="page-container" visible="false">
                <HBox alignment="CENTER_LEFT" spacing="10" styleClass="users-header">
                    <VBox spacing="2">
                        <Label styleClass="section-title" text="User Management" />
                        <Label styleClass="muted" text="Manage all users, roles, and permissions" />
                    </VBox>
                    <Region HBox.hgrow="ALWAYS" />
                    <Button onAction="#createUser" styleClass="btn-primary" text="Create User" />
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="10" styleClass="users-toolbar">
                    <StackPane styleClass="users-search-wrap" HBox.hgrow="ALWAYS">
                        <SVGPath content="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5C16 5.91 13.09 3 9.5 3S3 5.91 3 9.5S5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5Zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5S14 7.01 14 9.5S11.99 14 9.5 14Z" mouseTransparent="true" styleClass="users-search-icon" StackPane.alignment="CENTER_LEFT" />
                        <TextField fx:id="usersSearchField" promptText="Search by name or email..." styleClass="users-search" />
                    </StackPane>
                    <ComboBox fx:id="roleFilterCombo" promptText="All Roles" styleClass="users-role-filter" />
                    <Button onAction="#refreshUsers" styleClass="btn-secondary" text="Refresh" />
                </HBox>

                <TableView fx:id="usersTable" styleClass="users-table" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colName" prefWidth="220" text="User" />
                        <TableColumn fx:id="colEmail" prefWidth="240" text="Email" />
                        <TableColumn fx:id="colPhone" prefWidth="140" text="Phone" />
                        <TableColumn fx:id="colRole" prefWidth="120" text="Role" />
                        <TableColumn fx:id="colActions" prefWidth="140" text="Actions" />
                    </columns>
                </TableView>
            </VBox>

            <VBox fx:id="settingsPage" managed="false" spacing="12" styleClass="page-container" visible="false">
                <Label styleClass="section-title" text="Settings" />

                <VBox spacing="10" styleClass="card">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label styleClass="field-label" text="Dark mode" />
                        <Region HBox.hgrow="ALWAYS" />
                        <ToggleButton fx:id="themeToggleSettings" focusTraversable="false" onAction="#toggleThemeFromSettings" styleClass="theme-toggle" text="" />
                    </HBox>
                </VBox>
            </VBox>

            <VBox fx:id="profilePage" managed="false" spacing="12" styleClass="page-container" visible="false">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <VBox spacing="2">
                        <Label styleClass="section-title" text="Profile" />
                        <Label styleClass="muted" text="Manage your account information" />
                    </VBox>
                    <Region HBox.hgrow="ALWAYS" />
                    <Button onAction="#saveProfile" styleClass="btn-primary" text="Save Changes" />
                </HBox>

                <HBox spacing="14">
                    <VBox prefWidth="320" spacing="12" styleClass="card">
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <StackPane>
                                <Circle fx:id="profileAvatarCircle" radius="28" styleClass="profile-avatar" />
                                <ImageView fx:id="profileAvatarImage" fitHeight="56" fitWidth="56" pickOnBounds="true" preserveRatio="false" />
                            </StackPane>
                            <VBox spacing="2">
                                <Label fx:id="profileNamePreview" styleClass="section-title" text="" />
                                <Label fx:id="profileRolePreview" styleClass="muted" text="" />
                            </VBox>
                        </HBox>
                        <Label fx:id="profileStatusLabel" styleClass="muted" text="" />
                    </VBox>

                    <VBox spacing="12" styleClass="card" HBox.hgrow="ALWAYS">
                        <Label styleClass="section-title" text="Personal Information" />

                        <VBox spacing="10">
                            <VBox spacing="6">
                                <Label styleClass="field-label" text="Full name" />
                                <TextField fx:id="profileFullNameField" promptText="Full name" />
                            </VBox>

                            <VBox spacing="6">
                                <Label styleClass="field-label" text="Email" />
                                <TextField fx:id="profileEmailField" promptText="Email" />
                            </VBox>

                            <VBox spacing="6">
                                <Label styleClass="field-label" text="Phone" />
                                <TextField fx:id="profilePhoneField" promptText="Phone" />
                            </VBox>

                            <VBox spacing="6">
                                <Label styleClass="field-label" text="Profile photo" />
                                <StackPane fx:id="profilePhotoDropZone" minHeight="140" styleClass="drop-zone">
                                    <VBox alignment="CENTER" maxWidth="Infinity" spacing="8">
                                        <ImageView fx:id="profilePhotoPreview" fitHeight="92" fitWidth="92" managed="false" pickOnBounds="true" preserveRatio="true" visible="false" />
                                        <Label fx:id="profilePhotoHint" styleClass="muted" text="Drag &amp; drop a photo here" />
                                        <Button fx:id="choosePhotoButton" onAction="#chooseProfilePhoto" styleClass="btn-secondary" text="Choose file" />
                                    </VBox>
                                </StackPane>
                                <TextField fx:id="profilePhotoField" managed="false" visible="false" />
                            </VBox>
                        </VBox>
                    </VBox>
                </HBox>
            </VBox>

            </StackPane>
        </VBox>
    </center>

</BorderPane>
