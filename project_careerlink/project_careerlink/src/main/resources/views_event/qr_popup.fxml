<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.ImageView?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="Controllers.evenement.QrPopupController"
      alignment="CENTER"
      spacing="14"
      style="-fx-background-color: #13131a; -fx-padding: 36; -fx-background-radius: 20;">

    <Label text="Votre Ticket est Pret !"
           style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: white;"/>

    <Label text="Scannez avec votre telephone (meme WiFi)"
           style="-fx-font-size: 12px; -fx-text-fill: rgba(255,255,255,0.45);"/>

    <ImageView fx:id="qrImageView" fitWidth="280" fitHeight="280" preserveRatio="true"
               style="-fx-effect: dropshadow(gaussian, rgba(120,60,220,0.4), 20, 0, 0, 0);"/>

    <Label fx:id="ticketIdLabel"
           style="-fx-font-size: 15px; -fx-text-fill: #c084fc; -fx-font-weight: bold;"/>

    <Label fx:id="urlLabel" text="Demarrage du serveur..."
           style="-fx-font-size: 11px; -fx-text-fill: rgba(255,255,255,0.3); -fx-font-style: italic;"/>

    <Button text="Ouvrir sur ce PC"
            onAction="#openInBrowser"
            style="-fx-background-color: #7c3aed; -fx-text-fill: white; -fx-font-size: 13px;
                   -fx-padding: 11 28; -fx-background-radius: 10; -fx-cursor: hand; -fx-font-weight: 500;"/>

    <Button text="Fermer"
            onAction="#close"
            style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.35);
                   -fx-font-size: 12px; -fx-border-color: rgba(255,255,255,0.1);
                   -fx-border-radius: 8; -fx-padding: 8 20; -fx-cursor: hand;"/>
</VBox>
