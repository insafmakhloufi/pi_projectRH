<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Arc?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.SVGPath?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:id="quizRoot"
            fx:controller="Controllers.testQuizFront.QuizController"
            stylesheets="@css/quiz_view.css"
            styleClass="quiz-root"
            maxWidth="Infinity" maxHeight="Infinity">

    <!-- ═══ CENTER = main area + right sidebar ═══ -->
    <center>
        <HBox spacing="0" maxWidth="Infinity" maxHeight="Infinity">

            <!-- ══ ZONE PRINCIPALE ══ -->
            <VBox alignment="TOP_CENTER" spacing="18" styleClass="main-zone"
                  HBox.hgrow="ALWAYS" maxHeight="Infinity">

                <!-- ── TOPBAR quiz (sous la navbar dashboard) ── -->
                <HBox styleClass="quiz-topbar" alignment="CENTER_LEFT" spacing="14">
                    <padding><Insets top="14" right="20" bottom="14" left="20"/></padding>

                    <StackPane styleClass="topbar-icon-wrap">
                        <SVGPath styleClass="topbar-icon"
                                 content="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 14.5v-9l6 4.5-6 4.5z"/>
                    </StackPane>

                    <Label fx:id="quizTitleLabel" text="Quiz Session" styleClass="quiz-title" mouseTransparent="true"/>

                    <Region HBox.hgrow="ALWAYS"/>

                    <VBox alignment="CENTER" spacing="4" prefWidth="260">
                        <ProgressBar fx:id="progressBar" progress="0.0" styleClass="quiz-progress" maxWidth="Infinity"/>
                        <Label fx:id="progressLabel" text="Question 1 / 1" styleClass="progress-label" mouseTransparent="true"/>
                    </VBox>

                    <Region HBox.hgrow="ALWAYS"/>
                </HBox>

                <!-- ── CONTENU (question + choix + boutons) ── -->
                <VBox alignment="CENTER" spacing="24" VBox.vgrow="ALWAYS" maxHeight="Infinity">
                    <padding><Insets top="10" right="28" bottom="24" left="28"/></padding>

                    <!-- Card question -->
                    <VBox fx:id="questionCard" alignment="CENTER" spacing="26" styleClass="question-card"
                          maxWidth="Infinity" pickOnBounds="true">

                        <HBox alignment="CENTER">
                            <Label fx:id="questionBadge" text="Q 01" styleClass="question-badge" mouseTransparent="true"/>
                        </HBox>

                        <Label fx:id="questionLabel" text="Question..." wrapText="true"
                               styleClass="question-text" mouseTransparent="true"/>

                        <GridPane fx:id="optionsGrid" alignment="CENTER" hgap="14" vgap="14" pickOnBounds="false" maxWidth="Infinity">
                            <Button fx:id="optionAButton" text="A" styleClass="choice-btn" onAction="#handleOptionA"
                                    maxWidth="Infinity" GridPane.rowIndex="0" GridPane.columnIndex="0" GridPane.hgrow="ALWAYS"/>
                            <Button fx:id="optionBButton" text="B" styleClass="choice-btn" onAction="#handleOptionB"
                                    maxWidth="Infinity" GridPane.rowIndex="0" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS"/>
                            <Button fx:id="optionCButton" text="C" styleClass="choice-btn" onAction="#handleOptionC"
                                    maxWidth="Infinity" GridPane.rowIndex="1" GridPane.columnIndex="0" GridPane.hgrow="ALWAYS"/>
                            <Button fx:id="optionDButton" text="D" styleClass="choice-btn" onAction="#handleOptionD"
                                    maxWidth="Infinity" GridPane.rowIndex="1" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS"/>
                        </GridPane>

                        <TextField fx:id="openAnswerField"
                                   promptText="Écrivez votre réponse ici..."
                                   styleClass="open-answer-field"
                                   visible="false"
                                   managed="false"/>

                        <!-- Éditeur CODING (visible seulement pour questions CODING) -->
                        <VBox fx:id="codingBlock" visible="false" managed="false" spacing="10" maxWidth="Infinity">
                            <HBox styleClass="code-editor-topbar" alignment="CENTER_LEFT" spacing="10">
                                <Label fx:id="codingLangLabel" text="JAVA" styleClass="code-lang-badge"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label text="Code Editor" styleClass="code-editor-title"/>
                            </HBox>

                            <TextArea fx:id="codeEditorArea"
                                      promptText="// Écrivez votre code ici..."
                                      styleClass="code-editor-area"
                                      wrapText="false"
                                      prefRowCount="12"
                                      maxWidth="Infinity"/>

                            <HBox fx:id="aiFeedbackBox" visible="false" managed="false"
                                  styleClass="ai-feedback-box" alignment="CENTER_LEFT" spacing="10">
                                <SVGPath styleClass="ai-feedback-icon"
                                         content="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z"/>
                                <Label fx:id="aiFeedbackLabel" text="" wrapText="true"
                                       styleClass="ai-feedback-text" HBox.hgrow="ALWAYS"/>
                            </HBox>
                        </VBox>
                    </VBox>

                    <!-- Boutons action -->
                    <HBox alignment="CENTER" spacing="16" pickOnBounds="false">
                        <Button fx:id="btnSkip" onAction="#handleSkip" styleClass="btn-skip" pickOnBounds="true">
                            <graphic>
                                <HBox spacing="8" alignment="CENTER">
                                    <SVGPath styleClass="btn-icon-skip"
                                             content="M6 18L14.5 12 6 6v12zm.5-12l7 6-7 6V6zm10-2h2v16h-2z"/>
                                    <Label text="Passer" styleClass="btn-label-skip" mouseTransparent="true"/>
                                </HBox>
                            </graphic>
                        </Button>

                        <Button fx:id="btnNext" onAction="#handleNextQuestion" styleClass="btn-next" pickOnBounds="true">
                            <graphic>
                                <HBox spacing="8" alignment="CENTER">
                                    <Label text="Question suivante" styleClass="btn-label-next" mouseTransparent="true"/>
                                    <SVGPath styleClass="btn-icon-next"
                                             content="M8 5v14l11-7z"/>
                                </HBox>
                            </graphic>
                        </Button>
                    </HBox>
                </VBox>
            </VBox>

            <!-- ══ SIDEBAR DROITE ══ -->
            <VBox styleClass="stats-sidebar" alignment="TOP_CENTER" spacing="0" maxHeight="Infinity">
                <padding><Insets top="24" right="0" bottom="24" left="0"/></padding>

                <!-- ── TIMER ── -->
                <VBox styleClass="stat-block" alignment="CENTER" spacing="10">
                    <padding><Insets top="20" right="16" bottom="20" left="16"/></padding>

                    <StackPane styleClass="stat-icon-ring timer-ring">
                        <SVGPath styleClass="stat-svg timer-svg"
                                 content="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67V7z"/>
                    </StackPane>

                    <Label text="TEMPS" styleClass="stat-label"/>
                    <Label fx:id="timerLabel" text="10:00" styleClass="stat-value timer-val" mouseTransparent="true"/>
                </VBox>

                <Region styleClass="sidebar-sep" prefHeight="1" maxWidth="Infinity"/>

                <!-- ── SCORE ── -->
                <VBox styleClass="stat-block" alignment="CENTER" spacing="10">
                    <padding><Insets top="20" right="16" bottom="20" left="16"/></padding>

                    <StackPane styleClass="stat-icon-ring score-ring">
                        <SVGPath styleClass="stat-svg score-svg"
                                 content="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                    </StackPane>

                    <Label text="SCORE" styleClass="stat-label"/>
                    <Label fx:id="scoreLabel" text="0" styleClass="stat-value score-val" mouseTransparent="true"/>
                </VBox>

                <Region styleClass="sidebar-sep" prefHeight="1" maxWidth="Infinity"/>

                <!-- ── OK / KO ── -->
                <VBox styleClass="stat-block" alignment="CENTER" spacing="12">
                    <padding><Insets top="20" right="12" bottom="20" left="12"/></padding>

                    <HBox spacing="10" alignment="CENTER">
                        <!-- OK -->
                        <VBox styleClass="mini-block ok-block" alignment="CENTER" spacing="6">
                            <SVGPath styleClass="mini-svg ok-svg"
                                     content="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
                            <Label fx:id="okLabel" text="0" styleClass="mini-value ok-val" mouseTransparent="true"/>
                            <Label text="OK" styleClass="mini-label ok-label"/>
                        </VBox>

                        <!-- KO -->
                        <VBox styleClass="mini-block ko-block" alignment="CENTER" spacing="6">
                            <SVGPath styleClass="mini-svg ko-svg"
                                     content="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/>
                            <Label fx:id="koLabel" text="0" styleClass="mini-value ko-val" mouseTransparent="true"/>
                            <Label text="KO" styleClass="mini-label ko-label"/>
                        </VBox>
                    </HBox>
                </VBox>

                <Region styleClass="sidebar-sep" prefHeight="1" maxWidth="Infinity"/>

                <!-- ── PROGRESSION ARC ── -->
                <VBox styleClass="stat-block" alignment="CENTER" spacing="10" VBox.vgrow="ALWAYS">
                    <padding><Insets top="20" right="16" bottom="20" left="16"/></padding>

                    <Label text="PROGRESSION" styleClass="stat-label"/>

                    <StackPane>
                        <Circle radius="44" styleClass="arc-bg-circle"/>
                        <Arc fx:id="progressArc" radiusX="44" radiusY="44"
                             startAngle="90" length="0" type="OPEN"
                             styleClass="arc-fg-stroke"/>
                        <Label fx:id="arcLabel" text="0%" styleClass="arc-pct" mouseTransparent="true"/>
                    </StackPane>
                </VBox>

            </VBox>
        </HBox>
    </center>
</BorderPane>
