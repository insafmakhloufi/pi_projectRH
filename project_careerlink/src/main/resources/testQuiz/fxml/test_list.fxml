<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Controllers.testQuiz.TestListController"
            fx:id="rootPane"
            stylesheets="@../../Dashboardcss/style.css,@../css/style.css"
            styleClass="admin-root">

    <padding>
        <Insets top="18" right="18" bottom="18" left="18"/>
    </padding>

    <top>
        <VBox spacing="14">
            <Label text="Gestion Tests" styleClass="headline tests-page-title"/>
            <Label text="Module TestQuiz - edition rapide et affichage moderne" styleClass="tests-page-subtitle"/>

            <VBox spacing="10" styleClass="card tests-search-card">
                <padding>
                    <Insets top="14" right="14" bottom="14" left="14"/>
                </padding>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Recherche" styleClass="tests-card-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="langFrButton" text="FR" styleClass="btn-secondary lang-btn" onAction="#handleLangFr"/>
                    <Button fx:id="langEnButton" text="EN" styleClass="btn-secondary lang-btn" onAction="#handleLangEn"/>
                    <Button fx:id="langArButton" text="AR" styleClass="btn-secondary lang-btn" onAction="#handleLangAr"/>
                </HBox>
                <HBox spacing="10">
                    <TextField fx:id="searchTitreField" promptText="Filtre titre (contains)" styleClass="input"/>
                    <TextField fx:id="searchTypeField" promptText="Filtre type (contains)" styleClass="input"/>
                    <TextField fx:id="searchCandidatField" promptText="Filtre candidatID (equals)" styleClass="input"/>
                    <Button text="Generer (IA)" styleClass="btn-primary" onAction="#handleGenererIA"/>
                </HBox>
            </VBox>
        </VBox>
    </top>

    <center>
        <HBox spacing="14" styleClass="tests-body-split" BorderPane.alignment="CENTER">
            <BorderPane.margin>
                <Insets top="14" right="0" bottom="0" left="0"/>
            </BorderPane.margin>

            <VBox fx:id="leftBlock" styleClass="card tests-table-card tests-left-block interactive-block" HBox.hgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label text="Affichage Tests (Cards)" styleClass="tests-card-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button styleClass="btn-secondary btn-with-icon btn-icon-only" onAction="#handleRafraichir" text="Rafraichir">
                        <graphic>
                            <SVGPath styleClass="btn-icon-path" content="M17.65 6.35A7.95 7.95 0 0 0 12 4V1L7 6l5 5V7a5 5 0 1 1-5 5H5a7 7 0 1 0 12.65-5.65z"/>
                        </graphic>
                    </Button>
                </HBox>
                <Label fx:id="emptyStateLabel" text="Aucun test trouve." styleClass="tests-empty-state" visible="false" managed="false"/>

                <ScrollPane fitToWidth="true" fitToHeight="true" VBox.vgrow="ALWAYS" styleClass="tests-scroll">
                    <content>
                        <FlowPane fx:id="testsFlow" hgap="12" vgap="12" prefWrapLength="880" styleClass="tests-flow"/>
                    </content>
                </ScrollPane>
            </VBox>

            <Region styleClass="tests-split-separator"/>

            <VBox fx:id="rightBlock" spacing="10" styleClass="card tests-form-card tests-right-block interactive-block" prefWidth="430">
                <padding>
                    <Insets top="14" right="14" bottom="14" left="14"/>
                </padding>

                <Label text="Formulaire Test" styleClass="tests-card-title"/>
                <Label fx:id="formModeLabel" text="Mode: Ajout" styleClass="tests-form-mode"/>

                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" styleClass="tests-form-scroll">
                    <content>
                        <VBox spacing="10" styleClass="tests-form-content">
                            <ComboBox fx:id="formCandidatCombo" promptText="Candidat (Nom Prenom)" styleClass="input"/>
                            <Label fx:id="candidateValidationLabel" text="" styleClass="validation-text"/>

                            <TextField fx:id="formTitreField" promptText="Titre" styleClass="input"/>
                            <Label fx:id="titreValidationLabel" text="" styleClass="validation-text"/>

                            <ComboBox fx:id="formTypeCombo" promptText="Type" styleClass="input"/>
                            <Label fx:id="typeValidationLabel" text="" styleClass="validation-text"/>

                            <TextField fx:id="formScoreMaxField" promptText="ScoreMax" styleClass="input"/>
                            <Label fx:id="scoreValidationLabel" text="" styleClass="validation-text"/>

                            <TextField fx:id="formDurationSecondsField" promptText="Duration(s)" styleClass="input"/>
                            <Label fx:id="durationValidationLabel" text="" styleClass="validation-text"/>

                            <TextField fx:id="formTotalPointsField" promptText="TotalPoints" styleClass="input"/>
                            <Label fx:id="totalPointsValidationLabel" text="" styleClass="validation-text"/>

                            <HBox spacing="10">
                                <Button text="Annuler" styleClass="btn-secondary btn-with-icon" onAction="#handleAnnulerForm">
                                    <graphic>
                                        <SVGPath styleClass="btn-icon-path" content="M19 6.41 17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/>
                                    </graphic>
                                </Button>
                            </HBox>

                            <HBox spacing="10">
                                <Button fx:id="btnAjouter" text="Ajouter" styleClass="btn-primary" onAction="#handleAjouter"/>
                                <Button fx:id="btnModifier" text="Modifier" styleClass="btn-secondary" onAction="#handleModifier"/>
                                <Button text="Questions" styleClass="btn-secondary" onAction="#handleQuestions"/>
                                <Button text="Supprimer" styleClass="btn-danger" onAction="#handleSupprimer"/>
                            </HBox>
                        </VBox>
                    </content>
                </ScrollPane>
            </VBox>
        </HBox>
    </center>

</BorderPane>
