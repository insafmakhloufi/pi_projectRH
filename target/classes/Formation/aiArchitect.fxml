<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.Formation.AiArchitectController">
    <children>
        <HBox alignment="CENTER_LEFT" prefHeight="60.0" prefWidth="800.0" style="-fx-background-color: #f8f9fa; -fx-padding: 10;">
            <children>
                <Button fx:id="btnRetour" mnemonicParsing="false" text="Retour" />
                <Region HBox.hgrow="ALWAYS" />
                <Label text="Architecte de Parcours IA" textAlignment="CENTER">
                    <font>
                        <Font name="System Bold" size="18.0" />
                    </font>
                </Label>
            </children>
        </HBox>

        <VBox prefHeight="400.0" prefWidth="800.0" spacing="20.0" style="-fx-padding: 20;">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <Label text="Sélectionner une formation:" />
                        <ComboBox fx:id="cbFormations" prefWidth="300.0" />
                        <Button fx:id="btnGenerer" mnemonicParsing="false" text="Générer Parcours IA" />
                    </children>
                </HBox>

                <TextArea fx:id="taResult" editable="false" prefHeight="300.0" prefWidth="760.0" promptText="Le parcours IA apparaîtra ici..." wrapText="true" />
            </children>
        </VBox>
    </children>
</VBox>
